{
  "extends": "next/core-web-vitals",
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "public/sw.js",
    "scripts/**/*.cjs"
  ],
  "rules": {
    // Apostrophes and quotes in JSX prose render correctly; this rule exists to
    // catch stray delimiters, but in a copy-heavy marketing app it fires on
    // every contraction ("doesn't", "you'll") and produces pure noise. Left off
    // deliberately so a red lint means something real.
    "react/no-unescaped-entities": "off",
    // Next's App Router uses <a> for cross-app and external links in several
    // places by design; the rule assumes a pages/ directory it can enumerate.
    "@next/next/no-html-link-for-pages": "off"
  }
}
