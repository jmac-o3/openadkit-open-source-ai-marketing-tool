# OpenAdKit configuration
# ─────────────────────────────────────────────────────────────────────────
# install.bat / install.sh will create a real `.env.local` from this file
# and fill in your chosen port. You can also create `.env.local` by hand.
#
# Defaults are sensible — most users won't need to change anything.
# ─────────────────────────────────────────────────────────────────────────

# Web app port. Defaults to 3005.
#   Open  http://localhost:3005/  in your browser
#   Or    http://openadkit.localhost:3005/  (works in Chrome / Firefox / Safari / Edge
#         with NO setup — all modern browsers auto-resolve *.localhost to 127.0.0.1)
PORT=3005

# Local-sync sidecar port. Defaults to 3006. Bound to 127.0.0.1 only.
# The launcher (OpenAdKit.bat / .command) auto-resolves a free pair on first
# run and rewrites both keys below, so you rarely need to touch these.
ADFORGE_SYNC_PORT=3006

# Browser-visible mirror of ADFORGE_SYNC_PORT — MUST match it.
# Next.js only inlines NEXT_PUBLIC_* variables into the client bundle, so this
# is how the web app learns which port to call the sidecar on. If you change
# ADFORGE_SYNC_PORT by hand, change this too and rebuild (`npm run build`).
# lib/sync-endpoint.ts also probes 3006 / 41574 as fallbacks at runtime.
NEXT_PUBLIC_ADFORGE_SYNC_PORT=3006

# Optional friendly hostname.
# Leave commented out for the default (localhost).
# To use a custom hostname like  openadkit.local  you need a hosts file entry:
#   Windows:    run  scripts\set-domain.bat  as Administrator
#   Mac/Linux:  run  bash scripts/set-domain.sh  with sudo
# After that, open  http://openadkit.local:3005/  in your browser.
# See docs/CUSTOM_DOMAIN.md for details + the simpler *.localhost option.
# ADFORGE_HOSTNAME=openadkit.local
